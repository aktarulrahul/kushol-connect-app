{
  "name": "kushol-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "doctor": "expo-doctor",
    "sync:api-spec": "node scripts/sync-api-spec.mjs",
    "generate:api": "openapi-typescript openapi/openapi.yaml --output src/api/schema.gen.ts && prettier --write src/api/schema.gen.ts",
    "contracts:check": "node scripts/contracts-check.mjs",
    "gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:check"
  },
  "dependencies": {
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-dev-client": "57.0.19",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-status-bar": "57.0.1",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.20.4",
    "globals": "17.12.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
