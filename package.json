{
  "name": "kushol-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "doctor": "expo-doctor",
    "sync:api-spec": "node scripts/sync-api-spec.mjs",
    "generate:api": "openapi-typescript openapi/openapi.yaml --output src/api/schema.gen.ts && prettier --write src/api/schema.gen.ts",
    "contracts:check": "node scripts/contracts-check.mjs",
    "gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:rules && pnpm contracts:check",
    "test:rules": "node --test eslint-rules/*.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/hind-siliguri": "0.4.1",
    "@expo-google-fonts/inter": "0.4.2",
    "@rn-primitives/accordion": "1.5.2",
    "@rn-primitives/alert-dialog": "1.5.2",
    "@rn-primitives/aspect-ratio": "1.5.2",
    "@rn-primitives/avatar": "1.5.2",
    "@rn-primitives/checkbox": "1.5.2",
    "@rn-primitives/collapsible": "1.5.2",
    "@rn-primitives/context-menu": "1.5.2",
    "@rn-primitives/dialog": "1.5.2",
    "@rn-primitives/dropdown-menu": "1.5.2",
    "@rn-primitives/hover-card": "1.5.2",
    "@rn-primitives/label": "1.5.2",
    "@rn-primitives/menubar": "1.5.2",
    "@rn-primitives/popover": "1.5.2",
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/progress": "1.5.2",
    "@rn-primitives/radio-group": "1.5.2",
    "@rn-primitives/select": "1.5.2",
    "@rn-primitives/separator": "1.5.2",
    "@rn-primitives/slot": "1.5.2",
    "@rn-primitives/switch": "1.5.2",
    "@rn-primitives/tabs": "1.5.2",
    "@rn-primitives/toggle": "1.5.2",
    "@rn-primitives/toggle-group": "1.5.2",
    "@rn-primitives/tooltip": "1.5.2",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "lucide-react-native": "1.49.0",
    "nativewind": "4.2.7",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.20.4",
    "globals": "17.12.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "3.4.19",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
