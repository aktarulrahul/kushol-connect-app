# Kushol Connect app — copy to .env for local runs. Never commit real values.
# Parsed only by src/env.ts (FND-BR-002). EXPO_PUBLIC_* values ship inside the app bundle:
# they must never hold a secret. On a device, use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
