{
  "expo": {
    "name": "Kushol Connect",
    "slug": "kushol-connect",
    "scheme": "kusholconnect",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "./plugins/with-ios-scene-lifecycle",
      "expo-camera",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FA"
        }
      ],
      "expo-secure-store",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.kusholconnect.app",
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "package": "com.kusholconnect.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/adaptive-icon-monochrome.png",
        "backgroundColor": "#F7F8FA"
      }
    },
    "icon": "./assets/brand/icon.png"
  }
}
