{
  "expo": {
    "name": "Kushol Connect",
    "slug": "kushol-connect",
    "scheme": "kusholconnect",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-status-bar", "./plugins/with-ios-scene-lifecycle"],
    "experiments": { "typedRoutes": true },
    "ios": {
      "bundleIdentifier": "com.kusholconnect.app"
    },
    "android": {
      "package": "com.kusholconnect.app"
    }
  }
}
