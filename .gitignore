# Dependencies
/node_modules/
.pnpm-store/

# Expo
.expo/
/dist/
/web-build/
expo-env.d.ts
*.tsbuildinfo

# Native projects are generated by prebuild (CNG) — never committed
/ios/
/android/

# Native build artifacts / signing (EAS holds credentials)
*.apk
*.aab
*.ipa
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# Tests
/coverage/
/.maestro/output/

# Env — only .env.example is committed (EXPO_PUBLIC_* values ship in the bundle; secrets never go here)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
